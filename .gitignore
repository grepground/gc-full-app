# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Real secrets must never be committed. The template is explicitly allowed back
# in so contributors can see which variables exist without any real values.
.env*
!.env.example

# vercel
.vercel

# local upload storage — content (avatars, news covers, default-cover.jpg) is
# uploaded manually to the server and intentionally not committed.
public/images/
public/logo.png
public/uploads/
app/public/uploads/
app/public/images/

# pnpm local store (sandbox convenience)
/.pnpm-live

# typescript
*.tsbuildinfo
next-env.d.ts
