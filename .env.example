# ═══════════════════════════════════════════════════════════════════════════
# .env.example — TEMPLATE (every value is blank; no real information)
# ═══════════════════════════════════════════════════════════════════════════
#
# Usage: copy this file to `.env` (local) or `.env.production` (live), then
# fill in the values yourself.
#
#   cp .env.example .env
#   cp .env.example .env.production
#
# WARNING: never commit secrets. `.gitignore` already excludes every `.env*`
#   file, so only this template (.env.example) is tracked by git.

# ───────────────────────────────────────────────────────────────────────────
# SECRET — stays on the server only, never sent to the browser
# ───────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=""

# Session signing key. MUST BE AT LEAST 32 CHARACTERS.
# If missing or too short in production the app deliberately refuses to boot,
# rather than running with a weakened secret.
# Generate:  openssl rand -base64 48
SESSION_SECRET=""

# Salt that blinds the visitor fingerprints used by the view counter.
# Falls back to SESSION_SECRET when left blank. Keeping it separate lets you
# rotate this salt without invalidating everyone's session.
# Generate:  openssl rand -base64 48
VISIT_COUNTER_SALT=""

# Name of the session cookie. Falls back to a default when blank.
SESSION_COOKIE_NAME=""

# ───────────────────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ───────────────────────────────────────────────────────────────────────────

# May be left blank: no email is sent, but the app keeps working.
# Fill it in if you want password-reset mail to actually be delivered in
# production.
RESEND_API_KEY=""

# Sender address. Format: Name <address@yourdomain.com>
# Must use a domain verified with Resend.
MAIL_FROM=""

# Application name shown in outgoing emails.
APP_NAME=""

# ───────────────────────────────────────────────────────────────────────────
# MODERATION
# ───────────────────────────────────────────────────────────────────────────

# Words to mask in the feed, separated by commas.
# When blank, nothing is masked.
CENSORED_WORDS=""

# ───────────────────────────────────────────────────────────────────────────
# PUBLIC — NEXT_PUBLIC_* values are inlined into the browser bundle.
# Never put secrets here.
# ───────────────────────────────────────────────────────────────────────────

# Canonical site address (no trailing slash).
NEXT_PUBLIC_SITE_URL=""

# Brand / product name (shown in the header, page titles and metadata).
NEXT_PUBLIC_SITE_NAME=""

# Root domain, without a scheme.
NEXT_PUBLIC_SITE_DOMAIN=""

# Social media handle (without the leading @).
NEXT_PUBLIC_SOCIAL_HANDLE=""

# Contact email address.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Description used by search engines and link previews.
NEXT_PUBLIC_SITE_DESCRIPTION=""
